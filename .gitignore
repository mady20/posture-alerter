# Native Android & iOS Build Artifacts & Credentials
# ---------------------------------------------------------------------------
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.apk
*.aab
*.bundle
*.jsbundle

# ---------------------------------------------------------------------------
# Dependencies & Package Managers
# ---------------------------------------------------------------------------
node_modules/
.pnpm-debug.log*
npm-debug.*
yarn-debug.*
yarn-error.log

# ---------------------------------------------------------------------------
# Environment Variables & Secrets (NEVER commit these)
# ---------------------------------------------------------------------------
.env
.env.local
.env*.local

# ---------------------------------------------------------------------------
# Editors, Tools, & OS Metadata
# ---------------------------------------------------------------------------
# macOS
.DS_Store
*.pem

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/extensions.json

# JetBrains (WebStorm, Android Studio)
.idea/
*.iml

# TypeScript cache
*.tsbuildinfo
